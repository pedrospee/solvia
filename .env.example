# Copy this file to .env and adjust locally. Never commit .env.
# Only placeholder values belong here.

# development | test | production
NODE_ENV=development

# Absolute path to the SQLite database. The real database must live OUTSIDE this repository.
DATABASE_PATH=/Users/<you>/Library/Application Support/solvia/solvia.db

# Absolute path to the backup directory, also outside this repository.
BACKUP_DIR=/Users/<you>/Library/Application Support/solvia/backups

# Optional: absolute path for JSON exports (npm run data:export). Defaults to an
# "exports" directory next to BACKUP_DIR.
# EXPORT_DIR=/Users/<you>/Library/Application Support/solvia/exports

# HTTP port. The server always binds to 127.0.0.1 only.
PORT=3000
