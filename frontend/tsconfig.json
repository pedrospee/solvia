{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // A browser bundle built by Vite: DOM types, JSX, bundler resolution (ADR-0005, D1).
    "lib": ["es2024", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
