{
  "name": "solvia",
  "version": "0.0.0",
  "private": true,
  "description": "Personal financial planning system for EUR and BRL.",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:api": "npm run dev --workspace=@solvia/backend",
    "dev:ui": "npm run dev --workspace=@solvia/frontend",
    "start": "npm run start --workspace=@solvia/backend",
    "db:generate": "npm run db:generate --workspace=@solvia/backend",
    "db:migrate": "npm run db:migrate --workspace=@solvia/backend",
    "db:backup": "npm run db:backup --workspace=@solvia/backend",
    "db:restore": "npm run db:restore --workspace=@solvia/backend --",
    "data:export": "npm run data:export --workspace=@solvia/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "secrets:scan": "gitleaks git --redact --verbose .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
